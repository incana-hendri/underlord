# Optional. Exposed to the browser if set, so prefer pre-generated Kokoro files.
# Never commit a real key.
VITE_XAI_API_KEY=
# Deep mentor voice. Defaults to rex. See https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
VITE_XAI_TTS_VOICE=rex
# Override only if xAI moves the endpoint.
VITE_XAI_TTS_URL=https://api.x.ai/v1/tts
